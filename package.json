{
  "name": "open-claude-usage",
  "version": "1.0.0",
  "description": "Claude.ai usage monitor — system tray",
  "author": "william",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.william.open-claude-usage",
    "productName": "OpenClaudeUsage",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
