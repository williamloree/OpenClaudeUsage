{
  "name": "claude-usage-tray",
  "version": "1.0.0",
  "description": "Claude.ai usage monitor — system tray",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --portable"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.william.claude-usage-tray",
    "productName": "Claude Usage",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
